{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommuteTickDecision",
  "type": "object",
  "required": ["t", "scene", "coordinate_system", "should_service"],
  "properties": {
    "t": { "type": "string", "format": "date-time" },
    "coordinate_system": { "const": "WGS84" },
    "scene": {
      "enum": [
        "AT_HOME",
        "LEAVING_HOME",
        "AT_COMPANY",
        "LEAVING_COMPANY",
        "COMMUTE",
        "AWAY",
        "UNKNOWN"
      ]
    },
    "score_home": { "type": "number", "minimum": 0, "maximum": 1, "description": "Compatibility field: HSMM P(LEAVING_HOME)" },
    "score_company": { "type": "number", "minimum": 0, "maximum": 1, "description": "Compatibility field: HSMM P(LEAVING_COMPANY)" },
    "hsmm_phase_home": { "enum": ["AT_ANCHOR", "PRE_LEAVE", "LEAVING", "OUTSIDE"] },
    "hsmm_phase_company": { "enum": ["AT_ANCHOR", "PRE_LEAVE", "LEAVING", "OUTSIDE"] },
    "hsmm_preleave_home": { "type": "number", "minimum": 0, "maximum": 1 },
    "hsmm_preleave_company": { "type": "number", "minimum": 0, "maximum": 1 },
    "hsmm_outside_home": { "type": "number", "minimum": 0, "maximum": 1 },
    "hsmm_outside_company": { "type": "number", "minimum": 0, "maximum": 1 },
    "home_relation": { "enum": ["INSIDE", "NEAR", "OUTSIDE", "UNKNOWN"] },
    "company_relation": { "enum": ["INSIDE", "NEAR", "OUTSIDE", "UNKNOWN"] },
    "should_service": { "type": "boolean" },
    "service_intent": {
      "enum": ["NONE", "DEPARTURE_NOTIFICATION", "LEAVE_COMPANY_NOTIFICATION"]
    },
    "uncertainty": { "enum": ["LOW", "MEDIUM", "HIGH"] }
  }
}
