# commute_scene_baseline agent.env
# Device path: /data/service/el2/9903/agent.env
#
# Put real credentials in agent.env (not this example). Copy:
#   copy sa_service\etc\agent.env.example sa_service\etc\agent.env

# Credentials for theta personalization LLM (only when PersonalizationController fires).
# Not a call-frequency switch � LLM is never used for per-tick scene classification.
SA_AGENT_BASE_URL=https://api.deepseek.com/chat/completions
SA_AGENT_API_KEY=YOUR_DEEPSEEK_API_KEY

# Optional model override for host personalizer (DeepSeek). Device SA may use qwen.
# SA_AGENT_MODEL=deepseek-chat

# SA_AGENT_DEBUG_SINKS: optional verbose helloworld-style CSV dumps.
#   0 (default) = off
#   1 = write under .../commuteagentservice/sa_sensor_test/<run>/:
#       sensor_events.csv, sa_perception_ticks.csv, semantic_snapshots.csv,
#       agent_responses.csv, baseline_decisions.csv
#
# Product minimal set is ALWAYS written (independent of this flag) under
# /data/service/el1/public/commuteagentservice/:
#   anchors.json, theta.json,
#   leave_episodes.jsonl, leave_window_samples.jsonl,
#   param_changes.jsonl, personalize_jobs.jsonl
SA_AGENT_DEBUG_SINKS=0
