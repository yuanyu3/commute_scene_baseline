import("//build/ohos.gni")

ohos_shared_library("commuteagentservice_napi") {
  include_dirs = [
    "//foundation/multimedia/commute_scene_baseline/sa_service/services/include",
    "//foundation/multimedia/commute_scene_baseline/sa_service/services/include/ability",
    "//foundation/multimedia/commute_scene_baseline/sa_service/services/include/utils",
  ]

  defines = [ "OHOS_DEBUG" ]

  cflags = [
    "-fPIC",
    "-g3",
  ]

  sources = [
    "src/commuteagentservice_napi.cpp",
    "../../services/src/ability/AgentServiceProxy.cpp",
  ]

  deps = [
  ]

  external_deps = [
    "napi:ace_napi",
    "hilog:libhilog",
    "samgr:samgr_proxy",
    "safwk:system_ability_fwk",
    "ability_base:want",
    "ability_runtime:ability_manager",
    "ipc:ipc_core",
    "c_utils:utils",
  ]

  relative_install_dir = "module"

  subsystem_name = "multimedia"
  part_name = "commuteagentservice"
}
