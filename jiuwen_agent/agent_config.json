{

  "name": "commute_policy_personalizer",

  "framework": "jiuwen",

  "agent_type": "REACT",

  "max_turn": 16,

  "stream": false,

  "description": "Low-frequency personalization: evidence discovery plus bounded policy/theta counterfactual trials. Not per tick.",

  "system_prompt_file": "system_prompt.md",

  "tools": {

    "evidence": [

      "get_theta",

      "get_anchors",

      "get_error_stats",

      "get_leave_episode",

      "get_leave_window_samples",

      "get_leave_sensor_summary"

    ],

    "action": [

      "get_personalization_policy",

      "get_policy_catalog",

      "begin_policy_trial",

      "apply_policy_candidate",

      "evaluate_policy_on_history",

      "revert_policy_trial",

      "commit_policy_trial",

      "get_param_limits",

      "begin_theta_trial",

      "apply_theta_delta",

      "evaluate_theta_on_history",

      "revert_theta_trial",

      "commit_theta_trial",

      "write_audit",

      "request_anchor_reestimate"

    ]

  },

  "trigger": {

    "modes": ["AFTER_PUSH", "DAY_END", "manual"],

    "after_push_settle_s": 1200

  },

  "constraints": {

    "max_params_per_invoke": 5,

    "require_error_evidence": true,

    "require_eval_before_commit": true

  },

  "integration": {

    "register": "sa_agent::RegisterEvidenceTools + RegisterActionTools + Agent.AddTools",

    "query": "commute_sa::EvidenceQuery",

    "actions": "commute_sa::action_ops + personalization_policy + theta_eval",

    "host": "OHOS SA ProactiveAgentBusinessModule::TryInitializeAgent"

  }

}

