{

  "name": "commute_policy_personalizer",

  "framework": "jiuwen",

  "agent_type": "REACT",

  "max_turn": 16,

  "stream": false,

  "description": "Low-frequency personalization: evidence discovery, validated aborted-leave interpretation and bounded context-template synthesis. Not per tick.",

  "system_prompt_file": "system_prompt.md",

  "tools": {

    "evidence": [

      "get_theta",

      "get_anchors",

      "get_error_stats",

      "get_leave_episode",

      "get_leave_window_samples",

      "get_leave_sensor_summary",

      "get_episode_semantic_timeline",

      "get_episode_dynamic_diagnostics",

      "diagnose_context_template"
      ,"get_current_user_anchor_profile",

      "get_personalization_history_summary"

    ],

    "action": [

      "get_context_template_catalog",
      "get_aborted_leave_candidates",

      "get_active_context_template",

      "propose_aborted_leave_interpretation",

      "generate_context_template",

      "get_context_template_trial",

      "commit_context_template",

      "discard_context_template",

      "estimate_evidence_strength",

      "get_evidence_strength_trial",

      "commit_evidence_strength_candidate",

      "discard_evidence_strength_candidate",

      "fit_duration_prior",

      "get_duration_prior_trial",

      "commit_duration_prior_candidate",

      "discard_duration_prior_candidate",

      "submit_agent_analysis",

      "write_audit",

      "request_anchor_reestimate"

    ]

  },

  "trigger": {

    "modes": ["AFTER_PUSH", "DAY_END", "manual"],

    "after_push_settle_s": 1200

  },

  "constraints": {

    "max_params_per_invoke": 5,

    "require_error_evidence": true,

    "require_eval_before_commit": true

  },

  "integration": {

    "register": "sa_agent::RegisterEvidenceTools + RegisterActionTools + Agent.AddTools",

    "query": "commute_sa::EvidenceQuery",

    "actions": "commute_sa::context_template + theta_eval",

    "host": "OHOS SA ProactiveAgentBusinessModule::TryInitializeAgent"

  }

}

