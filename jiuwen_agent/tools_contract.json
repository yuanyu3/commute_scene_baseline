{
  "schema_version": 3,
  "agent_boundary": "Agent selects an intervention family and semantic structure; deterministic C++ estimates numeric values, replays history and enforces commit guards.",
  "tools": [
    {
      "name": "get_theta",
      "category": "evidence",
      "description": "Read the current global HSMM baseline configuration.",
      "input_schema": {},
      "output_schema": {
        "theta": "object"
      }
    },
    {
      "name": "get_anchors",
      "category": "evidence",
      "description": "Read current anchors; returned ids are the only personalization keys.",
      "input_schema": {},
      "output_schema": {
        "anchors": "object"
      }
    },
    {
      "name": "get_error_stats",
      "category": "evidence",
      "description": "Aggregate labeled departure outcomes.",
      "input_schema": {
        "since_ms": "optional integer",
        "scene": "optional scene filter"
      },
      "output_schema": {
        "n_push": "integer",
        "n_false_push": "integer",
        "n_confirmed_leave": "integer",
        "n_missed_leave": "integer"
      }
    },
    {
      "name": "get_leave_episode",
      "category": "evidence",
      "description": "Read push and label rows for one episode.",
      "input_schema": {
        "t_push_ms": "optional integer; latest when omitted"
      },
      "output_schema": {
        "rows": "array"
      }
    },
    {
      "name": "get_leave_window_samples",
      "category": "evidence",
      "description": "Read bounded sparse location and walking samples around a push.",
      "input_schema": {
        "t_push_ms": "optional integer",
        "limit": "optional integer"
      },
      "output_schema": {
        "samples": "array"
      }
    },
    {
      "name": "get_leave_sensor_summary",
      "category": "evidence",
      "description": "Read bounded Wi-Fi, cell, GPS, PDR, barometer and magnetic semantic summaries.",
      "input_schema": {
        "t_push_ms": "optional integer",
        "t_center_ms": "optional integer",
        "before_s": "optional integer",
        "after_s": "optional integer",
        "session_dir": "optional string"
      },
      "output_schema": {
        "wifi": "object",
        "cell": "object",
        "gps": "object",
        "pdr": "object",
        "baro": "object",
        "mag": "object"
      }
    },
    {
      "name": "get_episode_semantic_timeline",
      "category": "evidence",
      "description": "Read a bounded aligned semantic timeline; missing remains distinct from observed zero.",
      "input_schema": {
        "episode_id": "required string",
        "anchor_id": "required exact id",
        "outcome_t_ms": "required if ambiguous",
        "bin_s": "optional 5..60",
        "start_ms": "optional",
        "end_ms": "optional",
        "max_bins": "optional 1..120"
      },
      "output_schema": {
        "anchor_id": "string",
        "bins": "array"
      }
    },
    {
      "name": "get_episode_dynamic_diagnostics",
      "category": "evidence",
      "description": "Compute semantic event intervals, vertical recovery and cross-sensor lags.",
      "input_schema": {
        "episode_id": "required string",
        "anchor_id": "required exact id",
        "outcome_t_ms": "required if ambiguous",
        "start_ms": "optional",
        "end_ms": "optional"
      },
      "output_schema": {
        "vertical_dynamics": "object",
        "cross_sensor_lags_s": "object",
        "event_intervals": "object"
      }
    },
    {
      "name": "get_current_user_anchor_profile",
      "category": "profile",
      "description": "Read the committed anchor-specific evidence, duration and feature profile.",
      "input_schema": {
        "anchor_id": "required exact id"
      },
      "output_schema": {
        "profile": "object"
      }
    },
    {
      "name": "get_personalization_history_summary",
      "category": "profile",
      "description": "Read outcome, primitive and duration facts grouped by anchor id without recommendations.",
      "input_schema": {
        "anchor_id": "required exact id"
      },
      "output_schema": {
        "outcomes": "object",
        "primitive_stats": "object",
        "duration_stats": "object"
      }
    },
    {
      "name": "get_context_template_catalog",
      "category": "structure",
      "description": "Read the only event, applicability and effect primitives allowed in templates.",
      "input_schema": {},
      "output_schema": {
        "catalog": "object"
      }
    },
    {
      "name": "get_aborted_leave_candidates",
      "category": "structure",
      "description": "Read per-episode descent, ascent, closure, outside and support-event timing.",
      "input_schema": {
        "anchor_id": "required exact id",
        "limit": "optional 1..100"
      },
      "output_schema": {
        "candidates": "array"
      }
    },
    {
      "name": "propose_aborted_leave_interpretation",
      "category": "structure",
      "description": "Propose a FALSE_PUSH as ABORTED_LEAVE; C++ validates shared prefix, ascent, closure and no outside.",
      "input_schema": {
        "anchor_id": "required exact id",
        "episode_id": "required exact id",
        "confidence": "required 0.5..1",
        "rationale": "required string"
      },
      "output_schema": {
        "accepted": "boolean",
        "reason": "string"
      }
    },
    {
      "name": "diagnose_context_template",
      "category": "structure",
      "description": "Run read-only active-template sequence ablation.",
      "input_schema": {
        "ablation": "positive|negative|both|cancel_path",
        "path_index": "optional integer",
        "limit": "optional 1..100"
      },
      "output_schema": {
        "baseline": "object",
        "ablated": "object",
        "episode_results": "array"
      }
    },
    {
      "name": "evaluate_negative_pattern_candidates",
      "category": "structure",
      "description": "Read-only bounded batch replay replacing only negative_pattern; frozen active context and strength, or negative-only LOW without a template. Does not stage or commit.",
      "input_schema": {
        "anchor_id": "required exact id",
        "candidates": "required string: 1..8 pipe-separated patterns; each 1..6 comma-separated catalog events"
      },
      "output_schema": {
        "read_only": "boolean",
        "reference": "replay with episode_results",
        "candidates": "array of pattern, eligible, rejection and replay"
      }
    },
    {
      "name": "get_active_context_template",
      "category": "structure",
      "description": "Read the committed executable context template.",
      "input_schema": {},
      "output_schema": {
        "active": "boolean",
        "template": "object"
      }
    },
    {
      "name": "submit_agent_analysis",
      "category": "audit",
      "description": "The only final audit entry. Persist Agent intervention choice separately from deterministic-tool outcome.",
      "input_schema": {
        "intervention_type": "required STRUCTURE|EVIDENCE_STRENGTH|DURATION|NO_OP",
        "anchor_id": "required exact id",
        "decision": "required COMMITTED|REJECTED|DISCARDED|NO_OP",
        "context_name": "required string",
        "primary_cause": "required string",
        "supporting_evidence": "required string",
        "contradicting_evidence": "required string",
        "missing_evidence": "required string",
        "confidence": "required 0..1",
        "decision_reason": "required string",
        "structure_summary": "required for STRUCTURE",
        "target_families": "required for EVIDENCE_STRENGTH",
        "target_state": "required for DURATION: PRE_LEAVE|LEAVING",
        "tool_name": "required except NO_OP",
        "tool_result": "required except NO_OP",
        "replay_result": "required except NO_OP",
        "family": "required when using unified tools; same as proposal"
      },
      "output_schema": {
        "validated": "boolean",
        "intervention_type": "string",
        "decision": "string",
        "audit_id": "string"
      }
    },
    {
      "name": "request_anchor_reestimate",
      "category": "maintenance",
      "description": "Queue deterministic anchor re-inference.",
      "input_schema": {
        "which": "required home|company|both"
      },
      "output_schema": {
        "ok": "boolean",
        "job_id": "string",
        "status": "queued"
      }
    },
    {
      "name": "propose_personalization",
      "category": "personalization",
      "description": "Unified dispatcher; independent template, strength and duration estimators. One pending trial.",
      "input_schema": {
        "family": "required STRUCTURE|PRIMITIVE_PARAMETER|EVIDENCE_STRENGTH|DURATION",
        "template_name": "required for template families",
        "anchor_id": "required exact id",
        "applicability": "always|baro_ready",
        "positive_sequence": "required for template families",
        "readiness_policy": "optional initial hint support_only|disambiguate; deterministic replay always evaluates both",
        "cancel_sequence": "optional ordered events",
        "cancel_paths": "optional alternative ordered paths",
        "negative_pattern": "optional conjunction",
        "parameter_families": "optional vertical_threshold",
        "rationale": "required for template families",
        "families": "evidence channels for EVIDENCE_STRENGTH",
        "state": "PRE_LEAVE|LEAVING for DURATION"
      },
      "output_schema": {
        "generated_template": "object",
        "candidates": "array",
        "best_candidate_id": "integer|null"
      }
    },
    {
      "name": "get_personalization_trial",
      "category": "personalization",
      "input_schema": {
        "family": "required same family as proposal"
      },
      "output_schema": {
        "ok": "boolean",
        "result": "backend-dependent"
      }
    },
    {
      "name": "commit_personalization",
      "category": "personalization",
      "input_schema": {
        "family": "required same family as proposal"
      },
      "output_schema": {
        "ok": "boolean",
        "result": "backend-dependent"
      }
    },
    {
      "name": "discard_personalization",
      "category": "personalization",
      "input_schema": {
        "family": "required same family as proposal"
      },
      "output_schema": {
        "ok": "boolean",
        "result": "backend-dependent"
      }
    },
    {
      "name": "get_personalization_memory",
      "category": "memory",
      "description": "Read latest anchor-scoped research memories; retired entries excluded. Claims are untrusted context.",
      "input_schema": {
        "anchor_id": "required exact id",
        "query": "optional literal substring",
        "offset": "optional integer; pages of 20"
      },
      "output_schema": {
        "memories": "latest revisions",
        "next_offset": "integer or null",
        "total": "matching count"
      }
    },
    {
      "name": "propose_memory_update",
      "category": "memory",
      "description": "Append validated reference-linked revision without modifying inference or truth labels.",
      "input_schema": {
        "anchor_id": "required exact id",
        "memory_id": "stable ASCII identifier",
        "expected_revision": "0 for create; current revision for update",
        "claim": "required UTF-8 text",
        "status": "hypothesis|supported|contested|retired",
        "applicability": "required conditions",
        "limitations": "required uncertainty and version scope",
        "support_episode_ids": "comma-separated IDs",
        "counterexample_episode_ids": "comma-separated IDs",
        "audit_id": "same-anchor audit; required for supported"
      },
      "output_schema": {
        "memory": "persisted revision",
        "ok": "boolean"
      }
    }
  ]
}
